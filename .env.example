# Copie para .env.local. As chaves pertencem somente ao servidor.
# O Claude responde primeiro; o DeepSeek assume se o Claude falhar ou demorar.
# Basta um dos dois para a conversa funcionar.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_MODEL=deepseek-flash
# Voz conversacional masculina; Cedar com instruções expressivas em pt-BR.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
# Deixe vazio localmente. Use cloudflare somente atrás de uma borda Cloudflare
# confiável que sobrescreva o cabeçalho CF-Connecting-IP, ou proxy somente atrás
# de um único proxy reverso que acrescente o IP ao X-Forwarded-For (Easypanel).
TRUST_PROXY_HEADERS=
