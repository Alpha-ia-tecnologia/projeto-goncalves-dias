# Copie para .env.local. As chaves pertencem somente ao servidor.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
# Deixe vazio localmente. Use cloudflare somente atrás de uma borda Cloudflare
# confiável que sobrescreva o cabeçalho CF-Connecting-IP.
TRUST_PROXY_HEADERS=
